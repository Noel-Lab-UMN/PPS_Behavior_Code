clear all
clc
close all
%%
data_folder = '/Users/liushizhao/projects_local/PPS/data_ephys/LSZ_practice_5_violet_05_01_26_g0';
subjectCode = 'LSZ_practice_5_violet';
dateStr = '20260501';
dateStr_e = sprintf('%s_%s_%s',dateStr(5:6),dateStr(7:8), dateStr(1:4));

meta_folder = fullfile(data_folder, sprintf('%s_%s_behav',subjectCode, dateStr));


behav_data_save_name        = fullfile(meta_folder, ['behav_data_PPS_',subjectCode,'_',dateStr,'.mat']);
passive_data_save_name      = fullfile(meta_folder, ['passive_data_PPS_',subjectCode,'_',dateStr,'.mat']); 

if ~isfile(behav_data_save_name)
    EXP_CONFIG = util_pps.read_json_config(meta_folder, subjectCode, dateStr);
    [behav_data, prbs_behav_rising] = util_pps.read_csv_behav_data(meta_folder, EXP_CONFIG);
    save(behav_data_save_name, 'behav_data','EXP_CONFIG','prbs_behav_rising');
else
    load(behav_data_save_name);
end

if ~isfile(passive_data_save_name)
    [passive_data, prbs_passive_rising] = util_pps.read_csv_passive_data(meta_folder, subjectCode, dateStr);
    save(passive_data_save_name, 'passive_data', 'prbs_passive_rising');
else
    load(passive_data_save_name)
end
%%
% file_meta       = fullfile(data_folder, sprintf('%s_%s_g0_t0.nidq.meta', subjectCode, dateStr_e));
% file_bin        = fullfile(data_folder, sprintf('%s_%s_g0_t0.nidq.bin', subjectCode, dateStr_e));
file_meta       = fullfile(data_folder, 'LSZ_practice_5_violet_05_01_26_g0_t0.nidq.meta');
file_bin        = fullfile(data_folder, 'LSZ_practice_5_violet_05_01_26_g0_t0.nidq.bin');

NI_timing       = util_pps.read_binary_sync(file_meta, file_bin);
%% get the slope and intercept
nTrial_behav    = numel(behav_data);
nTrial_passive  = numel(passive_data);
nTrial_NI       = numel(NI_timing.trial_onset);

nPrbs_behav     = numel(prbs_behav_rising);
nPrbs_passive   = numel(prbs_passive_rising);
nPrbs_NI        = numel(NI_timing.prbs_rising); 

%%
if nTrial_behav + nTrial_passive == nTrial_NI
    flag_trial_onset_equal = true;
else
    flag_trial_onset_equal = false;
end

if nPrbs_behav + nPrbs_passive == nPrbs_NI
    flag_prbs_equal = true;
else
    flag_prbs_equal = false;
end
%%
%%%% Align to timing in .csv files
%%%% CSV_timing = p(1) * NI_timing + p(2)
%%%% So, NI_timing should be x and CSV_timing should be y
if flag_trial_onset_equal 
    %%% If trial onset works, use trial onset to align
    x           = NI_timing.trial_onset(1:nTrial_behav);
    y           = [behav_data(:).t_global_s_onset];
    align_time.p_behav     = polyfit(x, y, 1);
    align_time.y_max_behav = [behav_data(end).t_global_s(end)];

    x           = NI_timing.trial_onset(nTrial_behav+1:end);
    y           = [passive_data(:).t_global_s_onset];
    align_time.p_passive   = polyfit(x, y, 1);
    align_time.y_max_passive = [passive_data(end).t_global_s(end)];
elseif ~flag_trial_onset_equal & flag_prbs_equal
    % Otherwise use prbs
    x       = NI_timing.prbs_rising(1:nPrbs_behav);
    y       = prbs_behav_rising;
    align_time.p_behav = polyfit(x, y, 1);
    align_time.y_max_behav = [behav_data(end).t_global_s(end)];

    x       = NI_timing.prbs_rising(nPrbs_behav+1 : end);
    y       = prbs_passive_rising;
    align_time.p_passive = polyfit(x,y,1); 
    align_time.y_max_passive =  [passive_data(end).t_global_s(end)];


elseif ~flag_trial_onset_equal & ~flag_prbs_equal
    % Neither works, throw error message, requires some manual adjustment
    error('Neither trial onset or prbs match for alignment')
end
  

%% use the fit to align spike times
probe_folder = fullfile(data_folder, 'LSZ_practice_5_violet_05_01_26_g0_imec0';)
individual_cluster_folder = fullfile(data_folder, 'ksdata_individual_cluster');

cluster_list = dir(fullfile(individual_cluster_folder, '*.mat'));
nCluster = numel(cluster_list);

for i_cluster = 1:nCluster
    fprintf('align cluster %d/%d \n', i_cluster, nCluster)
    cluster_file_name = fullfile(individual_cluster_folder, cluster_list(i_cluster).name);
    load(cluster_file_name);
    spike_times = neuron.n.st_sec;

    %%% align spike_times to behav_data
    min_spike_time = -5;
    max_spike_time = align_time.y_max_behav + 10;
    spike_times_behav = align_time.p_behav(1) * spike_times + align_time.p_behav(2);
    is_keep = spike_times_behav >= min_spike_time & spike_times_behav <= max_spike_time;
    spike_times_behav = spike_times_behav(is_keep);
    %%% align spike_times to passive_data
    min_spike_time = -5;
    max_spike_time = align_time.y_max_passive + 10;
    spike_times_passive = align_time.p_passive(1) * spike_times + align_time.p_passive(2);
    is_keep = spike_times_passive >= min_spike_time & spike_times_passive <= max_spike_time;
    spike_times_passive = spike_times_passive(is_keep);
    
    neuron.n.spike_times_behav = spike_times_behav;
    neuron.n.spike_times_passive = spike_times_passive;

    neuron.aligned = true;
    save(cluster_file_name, 'neuron');
end

